generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String    @id @default(cuid())
  email   String    @unique
  passwordHash    String
  dailyLimitMin   Int   @default(30)
  createdAt   DateTime    @default(now())
  sessions    ScrollSession[]
  sites     TrackedSites[]
  dailyUsage    DailyUsage[]
}

model ScrollSession {
  id    String    @id @default(cuid())
  userId    String
  user    User    @relation(fields: [userId], references: [id])
  source    String
  startedAt   DateTime
  endedAt   DateTime?
  mood    Int?
  note    String?

  @@index([userId, startedAt])
}

model TrackedSites {
   id    String    @id @default(cuid())
   userId    String
   user    User    @relation(fields: [userId], references: [id])
   domain   String
   dailyLimitMin    Int?

   @@unique([userId, domain]) 
}

model DailyUsage {
   id    String    @id @default(cuid())
   userId    String
   user    User    @relation(fields: [userId], references: [id])
   domain   String
   date   DateTime    @db.date
   seconds    Int   @default(0)
   scrollPx   Int   @default(0)

   @@unique([userId, domain, date])
}